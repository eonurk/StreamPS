{
  "appId": "com.streamps.app",
  "productName": "StreamPS",
  "asar": true,
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources/ffmpeg/${os}",
      "to": "ffmpeg/${os}"
    },
    {
      "from": ".next/standalone",
      "to": "app-server"
    },
    {
      "from": ".next/static",
      "to": "app-server/.next/static"
    },
    {
      "from": "public",
      "to": "app-server/public"
    }
  ],
  "mac": {
    "target": "dmg",
    "identity": null
  },
  "dmg": {
    "title": "${productName}",
    "window": { "width": 540, "height": 380 }
  },
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "runAfterFinish": true
  },
  "linux": {
    "target": "AppImage",
    "category": "AudioVideo"
  }
}
